{
  "info": {
    "name": "qa-service-user API Tests",
    "description": "针对 qa-service-user 服务的接口测试集合。覆盖 TestController 所有端点。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Test",
      "description": "TestController 接口测试（/api/test）",
      "item": [
        {
          "name": "GET /api/test/cors - CORS测试",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[状态码] 返回 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('[响应结构] 包含必需字段', () => {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "    pm.expect(jsonData).to.have.property('service');",
                  "});",
                  "",
                  "pm.test('[字段值] service 为 qa-service-user', () => {",
                  "    pm.expect(jsonData.service).to.eql('qa-service-user');",
                  "});",
                  "",
                  "pm.test('[字段类型] 字段类型正确', () => {",
                  "    pm.expect(jsonData.message).to.be.a('string');",
                  "    pm.expect(jsonData.timestamp).to.be.a('number');",
                  "    pm.expect(jsonData.service).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('[Header] Content-Type 包含 application/json', () => {",
                  "    pm.response.to.have.header('Content-Type');",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('[性能] 响应时间 < 3000ms', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlUser}}/api/test/cors",
              "host": ["{{baseUrlUser}}"],
              "path": ["api", "test", "cors"]
            }
          }
        },
        {
          "name": "POST /api/test/cors - CORS POST测试(带请求体)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[状态码] 返回 200', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('[响应结构] 包含必需字段', () => {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('receivedData');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "    pm.expect(jsonData).to.have.property('service');",
                  "});",
                  "",
                  "pm.test('[字段值] message 正确', () => {",
                  "    pm.expect(jsonData.message).to.eql('POST request with CORS is working!');",
                  "});",
                  "",
                  "pm.test('[消息回显] receivedData 与请求体一致', () => {",
                  "    pm.expect(jsonData.receivedData).to.be.an('object');",
                  "    pm.expect(jsonData.receivedData.testKey).to.eql('testValue');",
                  "});",
                  "",
                  "pm.test('[字段类型] 字段类型正确', () => {",
                  "    pm.expect(jsonData.message).to.be.a('string');",
                  "    pm.expect(jsonData.receivedData).to.be.an('object');",
                  "    pm.expect(jsonData.timestamp).to.be.a('number');",
                  "    pm.expect(jsonData.service).to.be.a('string');",
                  "});",
                  "",
                  "pm.test('[Header] Content-Type 包含 application/json', () => {",
                  "    pm.response.to.have.header('Content-Type');",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                  "});",
                  "",
                  "pm.test('[性能] 响应时间 < 3000ms', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"testKey\": \"testValue\",\n    \"name\": \"API Test\"\n}"
            },
            "url": {
              "raw": "{{baseUrlUser}}/api/test/cors",
              "host": ["{{baseUrlUser}}"],
              "path": ["api", "test", "cors"]
            }
          }
        },
        {
          "name": "POST /api/test/cors - 空请求体测试",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[状态码] 返回 200（空请求体可接受）', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "",
                  "pm.test('[响应结构] 包含必需字段', () => {",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    pm.expect(jsonData).to.have.property('receivedData');",
                  "    pm.expect(jsonData).to.have.property('timestamp');",
                  "    pm.expect(jsonData).to.have.property('service');",
                  "});",
                  "",
                  "pm.test('[空请求体] receivedData 为 null', () => {",
                  "    pm.expect(jsonData.receivedData).to.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{baseUrlUser}}/api/test/cors",
              "host": ["{{baseUrlUser}}"],
              "path": ["api", "test", "cors"]
            }
          }
        },
        {
          "name": "OPTIONS /api/test/cors - CORS预检",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[状态码] 返回 200（CORS预检通过）', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('[Header] CORS 头存在', () => {",
                  "    pm.response.to.have.header('Access-Control-Allow-Origin');",
                  "    pm.response.to.have.header('Access-Control-Allow-Methods');",
                  "});",
                  "",
                  "pm.test('[性能] 响应时间 < 3000ms', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "OPTIONS",
            "header": [
              {
                "key": "Origin",
                "value": "http://localhost:5173"
              },
              {
                "key": "Access-Control-Request-Method",
                "value": "GET"
              }
            ],
            "url": {
              "raw": "{{baseUrlUser}}/api/test/cors",
              "host": ["{{baseUrlUser}}"],
              "path": ["api", "test", "cors"]
            }
          }
        }
      ]
    }
  ]
}
