        "name": "Test",
        "description": {
          "content": "TestController 接口测试（/api/test）",
          "type": "text/plain"
        },
        "item": [
          {
            "id": "f585c814-f1c9-4a60-9253-591bff506463",
            "name": "GET /api/test/cors - CORS测试",
            "request": {
              "url": {
                "path": [
                  "api",
                  "test",
                  "cors"
                ],
                "host": [
                  "{{baseUrlUser}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "d8bbba97-7dd6-4507-b930-7339d1e59bd7",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('[状态码] 返回 200', () => {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "const jsonData = pm.response.json();",
                    "",
                    "pm.test('[响应结构] 包含必需字段', () => {",
                    "    pm.expect(jsonData).to.have.property('message');",
                    "    pm.expect(jsonData).to.have.property('timestamp');",
                    "    pm.expect(jsonData).to.have.property('service');",
                    "});",
                    "",
                    "pm.test('[字段值] service 为 qa-service-user', () => {",
                    "    pm.expect(jsonData.service).to.eql('qa-service-user');",
                    "});",
                    "",
                    "pm.test('[字段类型] 字段类型正确', () => {",
                    "    pm.expect(jsonData.message).to.be.a('string');",
                    "    pm.expect(jsonData.timestamp).to.be.a('number');",
                    "    pm.expect(jsonData.service).to.be.a('string');",
                    "});",
                    "",
                    "pm.test('[Header] Content-Type 包含 application/json', () => {",
                    "    pm.response.to.have.header('Content-Type');",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "pm.test('[性能] 响应时间 < 3000ms', () => {",
                    "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                    "});"
                  ],
                  "_lastExecutionId": "a930d5a2-d9e6-494f-8bc6-58726a569492"
                }
              }
            ]
          },
          {
            "id": "8a3f1f99-f384-4dba-98f2-fd72fbc794a9",
            "name": "POST /api/test/cors - CORS POST测试(带请求体)",
            "request": {
              "url": {
                "path": [
                  "api",
                  "test",
                  "cors"
                ],
                "host": [
                  "{{baseUrlUser}}"
                ],
                "query": [],
                "variable": []
              },
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "method": "POST",
              "body": {
                "mode": "raw",
                "raw": "{\n    \"testKey\": \"testValue\",\n    \"name\": \"API Test\"\n}"
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "410873c9-ac14-4444-a7be-e2b05a484d5b",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test('[状态码] 返回 200', () => {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "const jsonData = pm.response.json();",
                    "",
                    "pm.test('[响应结构] 包含必需字段', () => {",
                    "    pm.expect(jsonData).to.have.property('message');",
                    "    pm.expect(jsonData).to.have.property('receivedData');",
                    "    pm.expect(jsonData).to.have.property('timestamp');",
                    "    pm.expect(jsonData).to.have.property('service');",
                    "});",
                    "",
                    "pm.test('[字段值] message 正确', () => {",
                    "    pm.expect(jsonData.message).to.eql('POST request with CORS is working!');",
                    "});",
                    "",
                    "pm.test('[消息回显] receivedData 与请求体一致', () => {",
                    "    pm.expect(jsonData.receivedData).to.be.an('object');",
                    "    pm.expect(jsonData.receivedData.testKey).to.eql('testValue');",
                    "});",
                    "",
                    "pm.test('[字段类型] 字段类型正确', () => {",
                    "    pm.expect(jsonData.message).to.be.a('string');",
                    "    pm.expect(jsonData.receivedData).to.be.an('object');",
                    "    pm.expect(jsonData.timestamp).to.be.a('number');",
                    "    pm.expect(jsonData.service).to.be.a('string');",
                    "});",
                    "",
                    "pm.test('[Header] Content-Type 包含 application/json', () => {",
                    "    pm.response.to.have.header('Content-Type');",
                    "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
                    "});",
                    "",
                    "pm.test('[性能] 响应时间 < 3000ms', () => {",
                    "    pm.expect(pm.response.responseTime).to.be.below(3000);",
                    "});"
                  ],
                  "_lastExecutionId": "79053df6-722d-4cf2-9ba3-3744c5f2f4ef"
                }
              }
            ]
          },
